# ────────────────────────────────────────────────────────────────────────
# Contact form delivery (/api/contact)
# ─────────────────────────────────────────────────────────────────────────
# Preferred: SMTP through nodemailer. Fill these in to receive messages
# straight to your inbox, with the sender set as Reply-To.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=your_app_password
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=you@example.com

# Fallback: forward submissions to a Google Form (the template's original
# mechanism). Left commented so /api/contact returns a clear
# "not configured" response instead of failing at request time.
# find gform usage in api/contact/route.ts file
# GOOGLE_FORM_LINK=your_gform_prefilled_link
# GOOGLE_FORM_FIELD_ID_NAME=entry_field_id_gform
# GOOGLE_FORM_FIELD_ID_EMAIL=entry_field_id_gform
# GOOGLE_FORM_FIELD_ID_MESSAGE=entry_field_id_gform
# GOOGLE_FORM_FIELD_ID_SOCIAL=entry_field_id_gform

# Google Analytics — leave empty to disable analytics entirely
NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=

# Resume — what /resume redirects to (a local file or any external URL)
NEXT_PUBLIC_RESUME_LINK=/CV_Ahmed_Khlif.pdf

# Optional: Discord invite used by /community
# NEXT_PUBLIC_DISCORD_LINK=

# Portfolio assistant (keep the key server-side; never use NEXT_PUBLIC_ here)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
